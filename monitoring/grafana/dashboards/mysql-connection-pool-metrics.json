      "pluginVersion": "11.2.2",
      "targets": [
        {
          "expr": "up{job=\"hotel-demo-jvm-gc\", instance=~\"message-service|user-service|hotel-service|order-service|payment-service\"}",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "title": "Prometheus Scrape Status",
      "type": "stat"
    }
