#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

LAB="${1:-}"

usage() {
  cat <<'USAGE'
Usage: ./scripts/lab-up <lab>

Labs:
  nacos     Nacos + user-service provider + gateway-service consumer
  gateway   Gateway + Nacos + user-service mock backend
  rabbitmq  RabbitMQ + message-service demo for idempotency, reliability, and DLQ
  kafka     Kafka only, without Kafka UI
  sentinel  Sentinel Dashboard + user-service limit demo
  sentinel-chain  Gateway -> BFF -> A -> B Sentinel and Feign demo
  seata     Seata learning skeleton, downgraded for 4GB machines
  full      Legacy full hotel booking chain. Heavy.
USAGE
}

if [[ -z "$LAB" || "$LAB" == "-h" || "$LAB" == "--help" ]]; then
  usage
  exit 0
fi

if [[ ! "$LAB" =~ ^(nacos|gateway|rabbitmq|kafka|sentinel|sentinel-chain|seata|full)$ ]]; then
  echo "Unknown lab: $LAB" >&2
  usage
  exit 1
fi

mvn_cmd() {
  if [[ -x /opt/codex-runner/workspace/.local-tools/maven/bin/mvn && -x /opt/codex-runner/workspace/.local-tools/jdk/bin/java ]]; then
    export JAVA_HOME=/opt/codex-runner/workspace/.local-tools/jdk
    export PATH="/opt/codex-runner/workspace/.local-tools/maven/bin:$JAVA_HOME/bin:$PATH"
    mvn "$@"
  else
    docker run --rm \
      -v "$PWD:/workspace" \
      -w /workspace \
      maven:3.9.9-eclipse-temurin-17 \
      mvn "$@"
  fi
}

build_modules() {
  local modules="$1"
  echo "Building Java module(s): $modules"
  mvn_cmd -B -DskipTests -pl "$modules" -am package
}

stop_old_lab() {
  echo "Stopping previous lab containers, if any..."
  docker rm -f hotel-demo-sentinel-proxy hotel-demo-user-proxy hotel-demo-sentinel-dashboard-proxy >/dev/null 2>&1 || true
  if [[ -f /tmp/hotel-demo-sentinel-proxy.pid ]]; then
    kill "$(cat /tmp/hotel-demo-sentinel-proxy.pid)" >/dev/null 2>&1 || true
    rm -f /tmp/hotel-demo-sentinel-proxy.pid /tmp/hotel-demo-sentinel-proxy.log
  fi
  docker compose --profile full --profile sentinel-chain down --remove-orphans
}

wait_http() {
  local name="$1"
  local url="$2"
  local max="${3:-60}"
  local i
  printf 'Waiting for %s' "$name"
  for ((i = 1; i <= max; i++)); do
    if curl -fsS --max-time 2 "$url" >/dev/null 2>&1; then
      printf ' ok\n'
      return 0
    fi
    printf '.'
    sleep 2
  done
  printf '\n'
  echo "Timed out waiting for $name: $url" >&2
  return 1
}

wait_healthy() {
  local container="$1"
  local max="${2:-60}"
  local i status
  printf 'Waiting for %s health' "$container"
  for ((i = 1; i <= max; i++)); do
    status="$(docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$container" 2>/dev/null || true)"
    if [[ "$status" == "healthy" || "$status" == "running" ]]; then
      printf ' ok\n'
      return 0
    fi
    printf '.'
    sleep 2
  done
  printf '\n'
  echo "Timed out waiting for $container health" >&2
  return 1
}

print_next_steps() {
  case "$LAB" in
    nacos)
      cat <<'EOF'

Nacos lab is up.
Learn: service registration/discovery, provider/consumer relationship.

Open:
  Nacos:   http://127.0.0.1:8848/nacos

Verify:
  curl -s http://127.0.0.1:8081/users/1
  curl -s http://127.0.0.1:8080/api/users/1

Stop:
  ./scripts/lab-down
EOF
      ;;
    gateway)
      cat <<'EOF'

Gateway lab is up.
Learn: path routing, StripPrefix, lb:// service discovery routing.

Open:
  Gateway health: http://127.0.0.1:8080/actuator/health

Verify:
  curl -s http://127.0.0.1:8080/api/users/1
  curl -s http://127.0.0.1:8080/actuator/gateway/routes

Stop:
  ./scripts/lab-down
EOF
      ;;
    rabbitmq)
      cat <<'EOF'

RabbitMQ lab is up.
Learn: exchange, queue, routing key, publisher confirm, manual ack, idempotency, DLQ, DLQ compensation ACK.

Open:
  RabbitMQ: http://127.0.0.1:15672  guest/guest
  Gateway:  http://127.0.0.1:8080

Verify:
  curl -s -XPOST http://127.0.0.1:8080/api/messages/rabbitmq/demo/normal
  curl -s -XPOST 'http://127.0.0.1:8080/api/messages/rabbitmq/demo/duplicate?messageId=MSG-DEMO-1'
  curl -s -XPOST http://127.0.0.1:8080/api/messages/rabbitmq/demo/dead-letter
  curl -s -XPOST 'http://127.0.0.1:8080/api/messages/rabbitmq/demo/dead-letter/resolve-next?compensationNote=order%20status%20fixed%20manually'
  curl -s -XPOST http://127.0.0.1:8080/api/messages/rabbitmq/demo/unroutable
  curl -s http://127.0.0.1:8080/api/messages/rabbitmq/demo/status

RabbitMQ Console:
  Queues and Streams -> hotel.booking.created.queue
  Queues and Streams -> hotel.booking.created.dlq
  Exchanges -> hotel.booking.exchange
  Exchanges -> hotel.booking.dlx

Stop:
  ./scripts/lab-down
EOF
      ;;
    kafka)
      cat <<'EOF'

Kafka lab is up. Kafka UI is intentionally not started.
Learn: topic, producer, consumer group, offset.

Verify:
  docker exec hotel-demo-kafka /opt/kafka/bin/kafka-topics.sh \
    --bootstrap-server localhost:9092 --create --if-not-exists --topic lab.events
  printf 'hello kafka lab\n' | docker exec -i hotel-demo-kafka /opt/kafka/bin/kafka-console-producer.sh \
    --bootstrap-server localhost:9092 --topic lab.events
  docker exec hotel-demo-kafka /opt/kafka/bin/kafka-console-consumer.sh \
    --bootstrap-server localhost:9092 --topic lab.events --from-beginning --max-messages 1 --timeout-ms 5000

Stop:
  ./scripts/lab-down
EOF
      ;;
    sentinel)
      cat <<'EOF'

Sentinel lab is up.
Learn: Dashboard connection, resource name, blockHandler fallback.

Open:
  Sentinel Dashboard: http://127.0.0.1:8858

Verify:
  curl -s http://127.0.0.1:8081/users/lab/sentinel

In the Dashboard, add a flow rule for resource:
  userSentinelLab

Set QPS threshold to 1, then run several curls quickly.

Stop:
  ./scripts/lab-down
EOF
      ;;
    sentinel-chain)
      cat <<'EOF'

Sentinel chain lab is up.
Learn: Gateway resource, Web MVC resource, SentinelResource, Feign + Sentinel fallback,
and independent Sentinel cluster flow control.

Open:
  Sentinel Dashboard: http://127.0.0.1:8090
  Sentinel Dashboard local direct port: http://127.0.0.1:8858
  Nacos:              http://127.0.0.1:8848/nacos
  Grafana:            http://127.0.0.1:3000  admin/admin
  Prometheus:         http://127.0.0.1:9091
  Token server health:http://127.0.0.1:8720/actuator/health

Verify the full chain:
  curl -s http://127.0.0.1:8080/api/lab-chain/entry

Generate JVM/thread metrics for Grafana:
  curl -s 'http://127.0.0.1:8080/api/lab-chain/thread-test?tasks=32&busyMs=8000'
  ./scripts/demo-grafana-thread-metrics.sh

Grafana dashboard:
  Hotel Demo / Hotel Demo JVM and Thread Metrics

Expected chain:
  Gateway -> one of two sentinel-bff-service instances -> sentinel-a-service -> sentinel-b-service

Cluster flow control demo:
  ./scripts/demo-sentinel-cluster-flow.sh

Resources to look for in Sentinel Dashboard after a few requests:
  gateway-service: sentinel-chain-bff, /api/lab-chain/**
  sentinel-bff-service: chainBffEntry, /lab-chain/entry, sentinel-a-service GET /a/work
  sentinel-a-service: chainAWork, /a/work, sentinel-b-service GET /b/work
  sentinel-b-service: chainBWork, /b/work

Stop:
  ./scripts/lab-down
EOF
      ;;
    seata)
      cat <<'EOF'

Seata lab is up in downgraded 4GB mode.
Learn: Seata server console, client startup config, tx-service-group mapping.

Open:
  Seata console: http://127.0.0.1:7091
  Nacos:         http://127.0.0.1:8848/nacos

Verify:
  curl -s http://127.0.0.1:8082/actuator/health
  curl -s http://127.0.0.1:8084/actuator/health

Note:
  This lab does not start MySQL or execute a real AT transaction by default.
  Use full mode only when you want the heavier hotel booking flow.

Stop:
  ./scripts/lab-down
EOF
      ;;
    full)
      cat <<'EOF'

Full mode is up.
Warning: this starts the legacy hotel booking chain, Kafka UI, frontend static assets,
and all Java services. It can consume a lot of memory and disk IO on a 4GB server.

Open:
  Hotel Web: http://127.0.0.1:8080
  Gateway:   http://127.0.0.1:8080/api/hotels
  Nacos:     http://127.0.0.1:8848/nacos
  RabbitMQ:  http://127.0.0.1:15672  guest/guest
  Kafka UI:  http://127.0.0.1:8090
  Seata:     http://127.0.0.1:7091

Stop:
  ./scripts/lab-down
EOF
      ;;
  esac
}

case "$LAB" in
  nacos|gateway)
    build_modules "gateway-service,user-service"
    stop_old_lab
    docker compose --profile "$LAB" up -d nacos
    wait_http "Nacos" "http://127.0.0.1:8848/nacos/v1/console/health/readiness" 60
    docker compose --profile "$LAB" up -d --build user-service gateway-service
    wait_http "user-service" "http://127.0.0.1:8081/actuator/health" 60
    wait_http "gateway-service" "http://127.0.0.1:8080/actuator/health" 60
    ;;
  rabbitmq)
    build_modules "gateway-service,message-service"
    stop_old_lab
    # RabbitMQ lab 只启动 Nacos、RabbitMQ、Gateway、message-service，避免无关服务占用内存。
    docker compose --profile rabbitmq up -d nacos rabbitmq
    wait_http "Nacos" "http://127.0.0.1:8848/nacos/v1/console/health/readiness" 60
    # RabbitMQ 先健康后再启动 Java 服务，否则启动初期容易看到连接失败重试日志。
    wait_healthy "hotel-demo-rabbitmq" 60
    docker compose --profile rabbitmq up -d --build gateway-service message-service
    wait_http "message-service" "http://127.0.0.1:8085/actuator/health" 60
    wait_http "gateway-service" "http://127.0.0.1:8080/actuator/health" 60
    ;;
  kafka)
    stop_old_lab
    docker compose --profile kafka up -d kafka
    wait_healthy "hotel-demo-kafka" 90
    ;;
  sentinel)
    build_modules "user-service"
    stop_old_lab
    docker compose --profile sentinel up -d nacos sentinel-dashboard
    wait_http "Nacos" "http://127.0.0.1:8848/nacos/v1/console/health/readiness" 60
    wait_http "Sentinel Dashboard" "http://127.0.0.1:8858" 60
    docker compose --profile sentinel up -d --build user-service
    wait_http "user-service" "http://127.0.0.1:8081/actuator/health" 60
    ;;
  sentinel-chain)
    build_modules "gateway-service,sentinel-token-server,sentinel-bff-service,sentinel-a-service,sentinel-b-service"
    stop_old_lab
    docker compose --profile sentinel-chain up -d nacos sentinel-dashboard sentinel-dashboard-proxy prometheus grafana
    wait_http "Nacos" "http://127.0.0.1:8848/nacos/v1/console/health/readiness" 60
    wait_http "Sentinel Dashboard" "http://127.0.0.1:8858" 60
    wait_http "Sentinel Dashboard proxy" "http://127.0.0.1:8090" 30
    wait_http "Prometheus" "http://127.0.0.1:9091/-/ready" 30
    wait_http "Grafana" "http://127.0.0.1:3000/api/health" 60
    "$PWD/scripts/publish-sentinel-rules-to-nacos.sh"
    docker compose --profile sentinel-chain up -d --build sentinel-b-service sentinel-a-service sentinel-token-server
    wait_http "sentinel-b-service" "http://127.0.0.1:8088/actuator/health" 60
    wait_http "sentinel-a-service" "http://127.0.0.1:8087/actuator/health" 60
    wait_http "sentinel-token-server" "http://127.0.0.1:8720/actuator/health" 60
    docker compose --profile sentinel-chain up -d --build sentinel-bff-service sentinel-bff-service-2 gateway-service
    wait_http "sentinel-bff-service-1" "http://127.0.0.1:8086/actuator/health" 60
    wait_http "sentinel-bff-service-2" "http://127.0.0.1:8186/actuator/health" 60
    wait_http "gateway-service" "http://127.0.0.1:8080/actuator/health" 60
    ;;
  seata)
    build_modules "hotel-service,payment-service"
    stop_old_lab
    docker compose --profile seata up -d nacos seata-server
    wait_http "Nacos" "http://127.0.0.1:8848/nacos/v1/console/health/readiness" 60
    docker compose --profile seata up -d --build hotel-service payment-service
    wait_http "hotel-service" "http://127.0.0.1:8082/actuator/health" 60
    wait_http "payment-service" "http://127.0.0.1:8084/actuator/health" 60
    ;;
  full)
    echo "WARNING: full mode may be heavy on a 4GB server. Starting only because you explicitly requested 'full'."
    "$PWD/scripts/build-frontend.sh"
    echo "Building all Java modules..."
    mvn_cmd -B -DskipTests package
    stop_old_lab
    docker compose --profile full up -d nacos sentinel-dashboard rabbitmq kafka seata-server
    wait_http "Nacos" "http://127.0.0.1:8848/nacos/v1/console/health/readiness" 60
    wait_healthy "hotel-demo-rabbitmq" 60
    wait_healthy "hotel-demo-kafka" 90
    docker compose --profile full up -d --build gateway-service user-service hotel-service order-service payment-service message-service kafka-ui
    ;;
esac

print_next_steps
